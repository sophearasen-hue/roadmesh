# Rust
/target/
**/*.rs.bk

# Flutter / Dart
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages

# Python (reference)
__pycache__/
*.pyc

# Editors / OS
.idea/
.vscode/
.DS_Store

# Never commit secrets or signing material
*.pem
*.p8
*.p12
*.jks
*.keystore
.env

# Generated by `flutter gen-l10n` (runs in CI and on `flutter pub get`)
app/lib/l10n/app_localizations*.dart

# developer CA keys (scripts/devca) never go into git
devca-key.bin
.devca/

# Apple App Attestation Root CA: a public certificate, pinned in the server binary
!server/src/apple_app_attestation_root_ca.pem
